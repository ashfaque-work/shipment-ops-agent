{
  "description": "Single-turn tool-use golden set. An order id and its tracking number are treated as the same shipment; looking the order up first (get_order) is allowed for tracking/email requests. expect: tools that must be called; allow: tools that may additionally be called; forbid: tools that must not be called. args: key arguments checked on the first call of each expected tool (string values are matched case-insensitively; a list means any-of; numbers within 2%).",
  "cases": [
    {"id": "track-01", "category": "track", "message": "Where is order 4512 going to Lagos?",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"order_id": "4512"}}},
    {"id": "track-02", "category": "track", "message": "Can you check the status of MC100004521?",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"tracking_number": "MC100004521"}}},
    {"id": "track-03", "category": "track", "message": "Has order 4513 been delivered yet?",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"order_id": "4513"}}},
    {"id": "track-04", "category": "track", "message": "what's happening with #4518",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"order_id": "4518"}}},
    {"id": "track-05", "category": "track", "message": "Track mc100004527 please",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"tracking_number": "MC100004527"}}},
    {"id": "track-06", "category": "track", "message": "When will order 4530 arrive in Nairobi?",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"order_id": "4530"}}},
    {"id": "track-07", "category": "track", "message": "Is the Accra parcel for order 4533 out for delivery?",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"order_id": "4533"}}},
    {"id": "track-08", "category": "track", "message": "status for order no. 4536",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"order_id": "4536"}}},
    {"id": "track-09", "category": "track", "message": "Where's my shipment MC100000503?",
     "expect": ["track_shipment"], "allow": ["get_order"], "args": {"track_shipment": {"tracking_number": "MC100000503"}}},
    {"id": "track-10", "category": "track", "message": "Any update on order 4521 to Johannesburg? The customer is asking.",
     "expect": ["track_shipment"], "allow": ["get_order", "draft_customer_email"], "args": {"track_shipment": {"order_id": "4521"}}},

    {"id": "rates-01", "category": "rates", "message": "How much to ship 5 kg from Kolkata to Nairobi?",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Kolkata", "destination_city": "Nairobi", "weight_kg": 5}}},
    {"id": "rates-02", "category": "rates", "message": "Cheapest way to send a 12 kg box (50x40x30 cm) from Mumbai to Lagos",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Mumbai", "destination_city": "Lagos", "weight_kg": 12, "length_cm": 50, "width_cm": 40, "height_cm": 30, "priority": "cheapest"}}},
    {"id": "rates-03", "category": "rates", "message": "I need 3 kg delivered to Accra from Delhi within 5 days, what are my options?",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Delhi", "destination_city": "Accra", "weight_kg": 3, "deadline_days": 5}}},
    {"id": "rates-04", "category": "rates", "message": "Compare express vs economy for 20kg Dubai to Johannesburg",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Dubai", "destination_city": "Johannesburg", "weight_kg": 20}}},
    {"id": "rates-05", "category": "rates", "message": "Fastest option for 2 kg Kolkata to Mombasa",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Kolkata", "destination_city": "Mombasa", "weight_kg": 2, "priority": "fastest"}}},
    {"id": "rates-06", "category": "rates", "message": "Get me a quote for 120 kg of jute rugs from Kolkata to Durban",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Kolkata", "destination_city": "Durban", "weight_kg": 120}}},
    {"id": "rates-07", "category": "rates", "message": "What would it cost to send 750 g from Chennai to Abuja?",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Chennai", "destination_city": "Abuja", "weight_kg": 0.75}}},
    {"id": "rates-08", "category": "rates", "message": "Rates please: Mumbai to Nairobi, 8 kg, 40x30x20",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Mumbai", "destination_city": "Nairobi", "weight_kg": 8, "length_cm": 40, "width_cm": 30, "height_cm": 20}}},
    {"id": "rates-09", "category": "rates", "message": "Shipping 15kg from Bengaluru to Cape Town - what's the best balance of cost and speed?",
     "expect": ["compare_rates"], "args": {"compare_rates": {"origin_city": "Bengaluru", "destination_city": "Cape Town", "weight_kg": 15, "priority": ["balanced", null]}}},

    {"id": "create-01", "category": "create", "message": "Ship order 4550 with Standard",
     "expect": ["create_shipment"], "allow": ["get_order", "validate_address", "compare_rates"], "args": {"create_shipment": {"order_id": "4550", "service_code": "STANDARD"}}},
    {"id": "create-02", "category": "create", "message": "Please book express shipping for order 4553",
     "expect": ["create_shipment"], "allow": ["get_order", "validate_address", "compare_rates"], "args": {"create_shipment": {"order_id": "4553", "service_code": "EXPRESS"}}},
    {"id": "create-03", "category": "create", "message": "Create a shipment for order 4552 using freight",
     "expect": ["create_shipment"], "allow": ["get_order", "validate_address", "compare_rates"], "args": {"create_shipment": {"order_id": "4552", "service_code": "FREIGHT"}}},
    {"id": "create-04", "category": "create", "message": "Generate an economy label for order 4550",
     "expect": ["create_shipment"], "allow": ["get_order", "validate_address", "compare_rates"], "args": {"create_shipment": {"order_id": "4550", "service_code": "ECONOMY"}}},
    {"id": "create-05", "category": "create", "message": "Ship order 4553",
     "expect": [], "allow": ["get_order", "compare_rates", "validate_address"], "forbid": ["create_shipment"],
     "note": "No service given: the agent should look up the order / quote rates and ask, not book."},
    {"id": "create-06", "category": "create", "message": "I want to send order 4551 to the customer by standard shipping",
     "expect": ["create_shipment"], "allow": ["get_order", "validate_address", "compare_rates"], "args": {"create_shipment": {"order_id": "4551", "service_code": "STANDARD"}}},

    {"id": "address-01", "category": "address", "message": "Is the delivery address on order 4551 valid?",
     "expect": ["validate_address"], "allow": ["get_order"], "args": {"validate_address": {"order_id": "4551"}}},
    {"id": "address-02", "category": "address", "message": "Check this address: 14 Admiralty Way, Lekki, Lagos 106104, Nigeria",
     "expect": ["validate_address"], "args": {"validate_address": {"city": "Lagos", "country": ["NG", "Nigeria"], "postal_code": "106104"}}},
    {"id": "address-03", "category": "address", "message": "Validate this one: 5 Riverside Drive, Nairobi, Kenya",
     "expect": ["validate_address"], "args": {"validate_address": {"city": "Nairobi", "country": ["KE", "Kenya"]}}},
    {"id": "address-04", "category": "address", "message": "Can you verify order 4550's shipping address before we ship?",
     "expect": ["validate_address"], "allow": ["get_order"], "args": {"validate_address": {"order_id": "4550"}}},

    {"id": "email-01", "category": "email", "message": "Draft a delay notification email for order 4521",
     "expect": ["draft_customer_email"], "allow": ["track_shipment", "get_order"], "args": {"draft_customer_email": {"order_id": "4521", "email_type": ["delay", "auto", null]}}},
    {"id": "email-02", "category": "email", "message": "Write to the customer of order 4518 explaining the customs hold",
     "expect": ["draft_customer_email"], "allow": ["track_shipment", "get_order"], "args": {"draft_customer_email": {"order_id": "4518", "email_type": ["customs_hold", "auto", null]}}},
    {"id": "email-03", "category": "email", "message": "Email the customer of 4527 asking for a corrected address",
     "expect": ["draft_customer_email"], "allow": ["track_shipment", "get_order"], "args": {"draft_customer_email": {"order_id": "4527", "email_type": ["delivery_failed", "auto", null]}}},
    {"id": "email-04", "category": "email", "message": "Let the customer know order 4513 was delivered",
     "expect": ["draft_customer_email"], "allow": ["track_shipment", "get_order"], "args": {"draft_customer_email": {"order_id": "4513"}}},
    {"id": "email-05", "category": "email", "message": "Draft an update email for MC100004512",
     "expect": ["draft_customer_email"], "allow": ["track_shipment", "get_order"], "args": {"draft_customer_email": {"tracking_number": "MC100004512"}}},
    {"id": "email-06", "category": "email", "message": "Prepare a customer message about the delay on MC100004521",
     "expect": ["draft_customer_email"], "allow": ["track_shipment", "get_order"], "args": {"draft_customer_email": {"tracking_number": "MC100004521", "email_type": ["delay", "auto", null]}}},

    {"id": "docs-01", "category": "documents", "message": "Please check doc_1a2b3c4d5e for problems",
     "expect": ["analyze_documents"], "args": {"analyze_documents": {"document_ids": [["doc_1a2b3c4d5e"]]}}},
    {"id": "docs-02", "category": "documents", "message": "I uploaded doc_aaaa111122 (invoice) and doc_bbbb333344 (bill of lading) - do they match?",
     "expect": ["analyze_documents"], "args": {"analyze_documents": {"document_ids": [["doc_aaaa111122", "doc_bbbb333344"], ["doc_bbbb333344", "doc_aaaa111122"]]}}},

    {"id": "order-01", "category": "order", "message": "What's in order 4550 and who is it for?",
     "expect": ["get_order"], "args": {"get_order": {"order_id": "4550"}}},

    {"id": "none-01", "category": "no_tool", "message": "Hi! What can you help me with?",
     "expect": [], "forbid": ["create_shipment", "track_shipment", "compare_rates", "draft_customer_email", "analyze_documents", "validate_address", "get_order"]},
    {"id": "none-02", "category": "no_tool", "message": "What's the capital of France?",
     "expect": [], "forbid": ["create_shipment", "track_shipment", "compare_rates", "draft_customer_email", "analyze_documents", "validate_address", "get_order"]}
  ]
}
