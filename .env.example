# Copy to .env and fill in. Never commit .env.

# --- LLM providers (both have free tiers; you need at least one key) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Primary provider for the chat agent: groq | gemini
# On HTTP 429 the client automatically falls back to the other provider.
LLM_PROVIDER=groq
# Optional model overrides (defaults shown). Free-tier model line-ups change often:
# check https://console.groq.com/docs/models and https://ai.google.dev/gemini-api/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.1-flash-lite   (newest "flash" models allow ~20 req/day on free keys)
# Vision/document extraction always uses Gemini Flash
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# --- Carrier ---
# mock | fedex   (fedex is a documented stub; see shipops/carriers/fedex.py)
CARRIER=mock
# "inprocess" runs the mock carrier inside the API process (single-service deploys)
MOCK_CARRIER_URL=http://127.0.0.1:8001
CARRIER_TIMEOUT_S=3
CARRIER_MAX_RETRIES=2

# --- Mock carrier service ---
# Fixed reference clock keeps scenarios deterministic (evals depend on it).
# Use MOCK_CLOCK=now for a live demo with fresh dates.
MOCK_CLOCK=2026-10-01T09:00:00+00:00
MOCK_TIMEOUT_DELAY_S=10

# --- Demo / API ---
# DEMO_MODE=true runs the mock carrier in-process (one service, MOCK_CARRIER_URL ignored)
# and enables the request limits below
DEMO_MODE=false
RATE_LIMIT_PER_MINUTE=20
DEMO_DAILY_REQUEST_CAP=500
# true when behind a reverse proxy (Render): client IP from X-Forwarded-For
TRUST_PROXY=false
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js, read at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
